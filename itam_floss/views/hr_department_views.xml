<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_department_form_itam_floss" model="ir.ui.view">
        <field name="name">hr.department.form.itam.floss</field>
        <field name="model">hr.department</field>
        <field name="inherit_id" ref="hr.view_department_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='color']" position="after">
                <field name="note" placeholder="ITAM department notes..."/>
            </xpath>
        </field>
    </record>
</odoo>
